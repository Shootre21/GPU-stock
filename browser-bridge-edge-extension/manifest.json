{
  "manifest_version": 3,
  "name": "Larry Browser Bridge",
  "version": "0.1.0",
  "description": "Edge extension bridge for scoped browser actions with local approval-aware handoff.",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:4217/*",
    "http://localhost:4217/*",
    "http://127.0.0.1:4318/*",
    "http://localhost:4318/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Larry Browser Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://claude.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
